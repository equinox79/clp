{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clp",
  "version": "0.1.7",
  "identifier": "local.clp.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "clp",
        "width": 640,
        "height": 440,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFMzAyQkFCRTY1REZGMTUKUldRVi8xM21xeXN3N29xYmR3VGh5UG15MXMyTmlkWXh0RHZVeGJ2eHU4OEFLV1FPWllabVNvUE0K",
      "endpoints": ["https://github.com/equinox79/clp/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
